{
  "name": "@sindicatoesp/drr-agent-plugin",
  "version": "1.11.0",
  "description": "Standalone Agent Plugin for Disaster Risk Reduction (DRR) analytics, hazard exposure, GEM/HAZUS fragility modeling, and OASIS CAP alerts.",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sindicatoesp/drr-agent-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/sindicatoesp/drr-agent-plugin/issues"
  },
  "homepage": "https://github.com/sindicatoesp/drr-agent-plugin#readme",
  "bin": {
    "drr-tool": "./bin/cli.js",
    "drr-mcp": "./bin/mcp-server.js"
  },
  "scripts": {
    "lint": "node scripts/lint.js",
    "check": "node scripts/lint.js && bash tests/run-all-tests.sh",
    "test": "bash tests/run-all-tests.sh",
    "dpg:audit": "node scripts/dpg-audit.js",
    "data:export": "node scripts/dpg-data-portability.js export",
    "data:purge": "node scripts/dpg-data-portability.js purge",
    "generate:inventory": "node scripts/generate-inventory.js",
    "generate:validation-report": "node scripts/generate-validation-report.js",
    "infra:global": "node scripts/build-static-infra.js --mode global",
    "infra:regional": "node scripts/build-static-infra.js --mode regional",
    "precommit": "npm run check",
    "mcp": "node bin/mcp-server.js"
  },
  "keywords": [
    "agent-plugin",
    "mcp",
    "drr",
    "undrr",
    "disaster-risk-reduction",
    "digital-public-good",
    "dpg",
    "sdg-11",
    "sdg-13",
    "hazus",
    "gem",
    "sendai-framework",
    "cap"
  ],
  "author": "DRR Agent Plugin Contributors (sindicatoesp)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
