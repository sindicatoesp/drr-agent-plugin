# ==============================================================================
# DRR Analytics Agent Plugin - Environment Configuration
# Copy this file to .env or configure these variables in your agent client environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GDACS (Global Disaster Alert & Coordination System) Feed
# ------------------------------------------------------------------------------
# Official GDACS GeoJSON API endpoint. Override if using an internal UN proxy or cache mirror.
GDACS_FEED_URL="https://www.gdacs.org/gdacsapi/api/events/geteventlist/events4app"

# ------------------------------------------------------------------------------
# 2. USGS Earthquake Hazards Program API
# ------------------------------------------------------------------------------
# USGS FDSN-WS event service endpoint.
USGS_API_URL="https://earthquake.usgs.gov/fdsnws/event/1/query"

# Default minimum magnitude filter for automated queries (e.g. 4.5, 5.0, 6.0)
USGS_MIN_MAGNITUDE=4.5

# Maximum number of seismic events to return per query
USGS_DEFAULT_LIMIT=20

# ------------------------------------------------------------------------------
# 2b. WFP ADAM (Automated Disaster Analysis and Mapping) OGC API - Features
# ------------------------------------------------------------------------------
# Public WFP ADAM OGC API root endpoint (no API key required).
WFP_ADAM_API_URL="https://api.adam.geospatial.wfp.org/api"

# ------------------------------------------------------------------------------
# 3. Open-Meteo Weather & Flood Anticipatory Action API
# ------------------------------------------------------------------------------
# Public non-commercial endpoint (free, no API key required):
OPENMETEO_API_URL="https://api.open-meteo.com/v1/forecast"

# Commercial Customer API Key (Optional: leave blank for public free tier):
# If provided, customer-api.open-meteo.com will be used automatically.
OPENMETEO_API_KEY=""

# ------------------------------------------------------------------------------
# 3b. OGC SensorThings API v1.1 (Custom Government & Private Sensor Networks)
# ------------------------------------------------------------------------------
# Optional default OGC SensorThings v1.1 root URL (e.g. https://sensors.agency.gov/v1.1):
OGC_SENSORTHINGS_URL=""
OGC_SENSORTHINGS_API_KEY=""
OGC_SENSORTHINGS_API_KEY_HEADER="X-API-Key"

# ------------------------------------------------------------------------------
# 3c. STAC v1.0.0 Earth Observation Catalogs (Copernicus EMS, ICEYE, Floodbase)
# ------------------------------------------------------------------------------
# Optional default STAC API root URL (e.g. https://stac.agency.gov/v1):
STAC_API_URL=""
STAC_API_KEY=""
STAC_API_KEY_HEADER="X-API-Key"

# ------------------------------------------------------------------------------
# 3d. Custom National FDSN-WS & ShakeMap Seismic Feeds (BMKG, PHIVOLCS, EMSC)
# ------------------------------------------------------------------------------
# Optional default FDSN-WS event endpoint (e.g. https://seismic.agency.gov/fdsnws/event/1):
FDSN_API_URL=""
FDSN_API_KEY=""
FDSN_API_KEY_HEADER="X-API-Key"

# ------------------------------------------------------------------------------
# 3e. OGC API - Features (Sendai Target D Critical Infrastructure Overlays)
# ------------------------------------------------------------------------------
# Optional default OGC API - Features root URL (e.g. https://gis.agency.gov/ogcapi):
OGC_FEATURES_API_URL=""
OGC_FEATURES_API_KEY=""
OGC_FEATURES_API_KEY_HEADER="X-API-Key"

# ------------------------------------------------------------------------------
# 3f. OCHA HDX Humanitarian API (HAPI v2) & COD-AB Population Baselines
# ------------------------------------------------------------------------------
# Base URL for OCHA HDX HAPI v2 REST queries (SSRF-guarded):
HDX_HAPI_URL="https://hapi.humdata.org/api/v2"

# Registered OCHA HAPI app_identifier (required for live requests to hapi.humdata.org):
HAPI_APP_IDENTIFIER=""

# Public OCHA HDX CKAN Action API v3 package_search endpoint (no API key required; discovers COD-AB, COD-PS, WorldPop, Kontur & HOTOSM):
HDX_CKAN_URL="https://data.humdata.org/api/3/action/package_search"

# ------------------------------------------------------------------------------
# 3g. OpenStreetMap (Overpass API) Interim Critical Infrastructure Fallback
# ------------------------------------------------------------------------------
# Overpass API interpreter endpoint used when no authoritative national GIS source exists:
OSM_OVERPASS_URL="https://overpass-api.de/api/interpreter"

# ------------------------------------------------------------------------------
# 4. DELTA Resilience Core Application Integration
# ------------------------------------------------------------------------------
# Endpoint to connect with DELTA's internal MCP server:
DELTA_API_URL="http://localhost:3000/en/api/mcp"

# Secret API Key token for DELTA authentication (matches X-Auth header in DELTA DB):
DELTA_MCP_API_KEY=""

# ------------------------------------------------------------------------------
# 5. National Country Scoping & DELTA Push Guard
# ------------------------------------------------------------------------------
# DELTA is country software. Set the national target country/countries below.
# Disaster events occurring outside these target countries will NOT be pushed to DELTA.
# Examples: "Indonesia", "Vanuatu", or comma-separated "Indonesia,ID,IDN"
TARGET_COUNTRIES="*"
DELTA_COUNTRY=""

# Enforce strict country matching before pushing draft records into DELTA (default: true)
DELTA_COUNTRY_STRICT=true

# ------------------------------------------------------------------------------
# 6. Network, Proxy & Security Settings
# ------------------------------------------------------------------------------
# HTTP/HTTPS proxy for enterprise, government, or UN agency firewalls:
# HTTP_PROXY="http://proxy.agency.org:8080"
# HTTPS_PROXY="http://proxy.agency.org:8080"
# NO_PROXY="localhost,127.0.0.1"

# Request timeout in milliseconds (default: 8000ms):
DRR_REQUEST_TIMEOUT_MS=8000

# Custom User-Agent string for outgoing telemetry requests:
DRR_USER_AGENT="DRR-Agent-Plugin/1.7"

# Allow webhook dispatch to private/loopback addresses (default: false, SSRF-hardened):
# DRR_ALLOW_PRIVATE_WEBHOOKS=false

# ------------------------------------------------------------------------------
# 7. Operational & Publication Governance Modes
# ------------------------------------------------------------------------------
# Default OASIS CAP v1.2 <sender> identifier for generated CAP XML alerts:
DRR_CAP_SENDER="alerts@drr-agent-plugin.local"

# Set to true to enforce strict offline operation (blocks outbound network calls
# and requires passing samplePayload fixtures — ideal for air-gapped EOCs or CI):
DRR_OFFLINE_MODE=false

# Explicitly enable live production CAP / DELTA writes (default: false, fail-closed):
# DRR_ENABLE_PRODUCTION_PUBLISH=false

