# ==============================================================================
# DRR Analytics Agent Plugin - Environment Configuration
# Copy this file to .env or configure these variables in your agent client environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GDACS (Global Disaster Alert & Coordination System) Feed
# ------------------------------------------------------------------------------
# Official GeoJSON feed endpoint. Override if using an internal UN proxy or cache mirror.
GDACS_FEED_URL="https://www.gdacs.org/datareport/resources/GDACS_events.geojson"

# ------------------------------------------------------------------------------
# 2. USGS Earthquake Hazards Program API
# ------------------------------------------------------------------------------
# USGS FDSN-WS event service endpoint.
USGS_API_URL="https://earthquake.usgs.gov/fdsnws/event/1/query"

# Default minimum magnitude filter for automated queries (e.g. 4.5, 5.0, 6.0)
USGS_MIN_MAGNITUDE=4.5

# Maximum number of seismic events to return per query
USGS_DEFAULT_LIMIT=20

# ------------------------------------------------------------------------------
# 3. Open-Meteo Weather & Flood Anticipatory Action API
# ------------------------------------------------------------------------------
# Public non-commercial endpoint (free, no API key required):
OPENMETEO_API_URL="https://api.open-meteo.com/v1/forecast"

# Commercial Customer API Key (Optional: leave blank for public free tier):
# If provided, customer-api.open-meteo.com will be used automatically.
OPENMETEO_API_KEY=""

# ------------------------------------------------------------------------------
# 4. DELTA Resilience Core Application Integration
# ------------------------------------------------------------------------------
# Endpoint to connect with DELTA's internal MCP server:
DELTA_API_URL="http://localhost:3000/en/api/mcp"

# Secret API Key token for DELTA authentication (matches X-Auth header in DELTA DB):
DELTA_MCP_API_KEY=""

# ------------------------------------------------------------------------------
# 5. National Country Scoping & DELTA Push Guard
# ------------------------------------------------------------------------------
# DELTA is country software. Set the national target country/countries below.
# Disaster events occurring outside these target countries will NOT be pushed to DELTA.
# Examples: "Indonesia", "Vanuatu", or comma-separated "Indonesia,ID,IDN"
TARGET_COUNTRIES="*"
DELTA_COUNTRY=""

# Enforce strict country matching before pushing draft records into DELTA (default: true)
DELTA_COUNTRY_STRICT=true

# ------------------------------------------------------------------------------
# 6. Network, Proxy & Security Settings
# ------------------------------------------------------------------------------
# HTTP/HTTPS proxy for enterprise, government, or UN agency firewalls:
# HTTP_PROXY="http://proxy.agency.org:8080"
# HTTPS_PROXY="http://proxy.agency.org:8080"
# NO_PROXY="localhost,127.0.0.1"

# Request timeout in milliseconds (default: 8000ms):
DRR_REQUEST_TIMEOUT_MS=8000

# Custom User-Agent string for outgoing telemetry requests:
DRR_USER_AGENT="UNDRR-DRR-Agent-Plugin/1.1"

# ------------------------------------------------------------------------------
# 6. Operational Modes
# ------------------------------------------------------------------------------
# Set to true to enforce strict offline operation (blocks outbound network calls
# and requires passing samplePayload fixtures — ideal for air-gapped EOCs or CI):
DRR_OFFLINE_MODE=false
